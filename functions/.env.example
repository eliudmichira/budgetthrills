# App keys from https://developer.ebay.com/my/keys  (Production keyset)

# ---- NOWPayments (crypto checkout) ----
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ---- Stripe (card / Apple Pay / Google Pay checkout) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PUBLIC_BASE_URL=https://budgetthrills.com

# ---- Transactional email (order confirmations, shipping notices, contact replies, admin alerts) ----
# Set ONE provider key. Brevo is the default: 300 emails/day free, no domain needed.
#   Brevo:   app.brevo.com -> Senders & IPs -> Senders -> Add a sender (verify the address by email)
#            then SMTP & API -> API Keys -> Generate a new API key (starts with xkeysib-)
#   Resend:  resend.com -> API Keys (starts with re_). Production sending needs a verified domain.
#   SendGrid: 60-day trial only (starts with SG.)
# Then deploy functions and open Admin -> Settings -> Email -> "Send test email to me".
BREVO_API_KEY=
RESEND_API_KEY=
SENDGRID_API_KEY=
# Optional: force a provider (brevo | resend | sendgrid). Default: whichever key is set, else brevo.
EMAIL_PROVIDER=
# The verified sender address and display name
EMAIL_FROM=
EMAIL_FROM_NAME=BudgetThrills
# Replies from customers go here (defaults to the sender)
SUPPORT_EMAIL=
# Contact-form alerts go here (defaults to the sender)
ADMIN_EMAIL=
# Brevo contact list that the homepage "Get the drop" form subscribes to (default: 2, "Your first list")
BREVO_LIST_ID=2
# Brevo transactional template IDs (defaults: 1 confirmation, 2 shipped, 3 contact reply). Set to 0 to use inline HTML.
BREVO_TEMPLATE_ORDER_CONFIRMATION=1
BREVO_TEMPLATE_ORDER_SHIPPED=2
BREVO_TEMPLATE_REPLY=3

# eBay Browse API (catalog sync). Production keyset from https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: comma-separated admin UIDs / emails allowed to trigger syncs from the dashboard
ADMIN_UIDS=
ADMIN_EMAILS=
