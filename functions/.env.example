# App keys from https://developer.ebay.com/my/keys  (Production keyset)

# ---- NOWPayments (crypto checkout) ----
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ---- Stripe (card / Apple Pay / Google Pay checkout) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PUBLIC_BASE_URL=https://budgetthrills.com

# ---- SendGrid (order confirmations, shipping notices, contact replies, admin alerts) ----
# 1. sendgrid.com -> Settings -> API Keys -> Create (Mail Send: Full Access). Paste below.
# 2. Settings -> Sender Authentication -> Single Sender Verification: verify the address you
#    will send from (your Gmail works until you own a domain). Put that address below.
# 3. Deploy functions, then open Admin -> Settings -> Email and press "Send test email".
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=BudgetThrills
# Replies from customers go here (defaults to the sender)
SUPPORT_EMAIL=
# Contact-form alerts go here (defaults to the sender)
ADMIN_EMAIL=

# eBay Browse API (catalog sync). Production keyset from https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: comma-separated admin UIDs / emails allowed to trigger syncs from the dashboard
ADMIN_UIDS=
ADMIN_EMAILS=
