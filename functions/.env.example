# App keys from https://developer.ebay.com/my/keys  (Production keyset)

# ---- NOWPayments (crypto checkout) ----
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ---- Stripe (card / Apple Pay / Google Pay checkout) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PUBLIC_BASE_URL=https://budgetthrills.com

# SendGrid for order/contact emails
SENDGRID_API_KEY=

# eBay Browse API (catalog sync). Production keyset from https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: comma-separated admin UIDs / emails allowed to trigger syncs from the dashboard
ADMIN_UIDS=
ADMIN_EMAILS=
