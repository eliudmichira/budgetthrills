rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Master admin helper
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'ExPolSW2P8UvRYLI4bowoRjCRix1' ||
        request.auth.token.email == 'eliudsamuel17@gmail.com'
      );
    }

    // Users can read/write only their own profile + subcollections (or admin)
    match /users/{uid} {
      allow read, write: if (request.auth != null && request.auth.uid == uid) || isAdmin();

      match /{sub=**} {
        allow read, write: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      }
    }

    // Contact form submissions - anyone can write, authenticated users can read & reply
    match /contact-messages/{msgId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;

      match /replies/{replyId} {
        allow create, read: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // Orders collection - customers create at checkout, authenticated admins manage & stream
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Coupons collection - customers read to validate, authenticated admins create/modify
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
