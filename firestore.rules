rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Master admin helper
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'ExPolSW2P8UvRYLI4bowoRjCRix1' ||
        request.auth.token.email == 'eliudsamuel17@gmail.com' ||
        request.auth.token.email == 'eliudsamwels7@gmail.com'
      );
    }

    // Users can read/write only their own profile + subcollections (or admin)
    match /users/{uid} {
      allow read, write: if (request.auth != null && request.auth.uid == uid) || isAdmin();

      match /{sub=**} {
        allow read, write: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      }
    }

    // Contact form submissions - anyone can write, authenticated users can read & reply
    match /contact-messages/{msgId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;

      match /replies/{replyId} {
        allow create, read: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // Orders: guests create a pending order at checkout; payment webhooks and the admin
    // dashboard (server SDK / isAdmin) are the only writers after that. Customers list
    // their own orders; guest tracking goes through the trackOrder function.
    match /orders/{orderId} {
      allow create: if request.resource.data.status == 'pending_payment'
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.items is list
                    && request.resource.data.id == orderId;
      allow get: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Coupons collection - customers read to validate, admins create/modify
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store settings (shipping thresholds, notice) - public read, admin write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
