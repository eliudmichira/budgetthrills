rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product photos copied by the catalog sync: public, written only by the server
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
